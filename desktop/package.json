{
  "name": "osu-coop-host",
  "version": "0.1.0",
  "description": "Desktop host for osu! co-op: native screen capture and input injection",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "node build.mjs && electron-builder --win portable"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "peerjs": "^1.5.5",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "app.osucoop.host",
    "productName": "osu co-op host",
    "files": ["dist/**/*", "package.json"],
    "asarUnpack": ["node_modules/koffi/**"],
    "directories": { "output": "release" },
    "win": { "target": ["portable"] }
  }
}
